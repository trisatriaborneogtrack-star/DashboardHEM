# ============================================================
# Contoh secrets. JANGAN commit file secrets.toml yang asli.
#
# Lokal  : salin file ini jadi .streamlit/secrets.toml
# Cloud  : tempel isinya di App settings -> Secrets (bukan di repo)
# ============================================================

[gsheet]
sheet_id = "1I30t7uLOzwBMVyq0k-Rfy1NTzGUFLbT9v37XeFjKbF0"
worksheet_responses = "Form Responses 1"
worksheet_roster = "Sheet1"

# Isi dari file JSON service account Google Cloud.
# private_key harus pakai triple-quote dan tetap mempertahankan \n.
[gcp_service_account]
type = "service_account"
project_id = "nama-project-anda"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = """-----BEGIN PRIVATE KEY-----
BARIS_KUNCI_1
BARIS_KUNCI_2
-----END PRIVATE KEY-----
"""
client_email = "dashboard-hemp@nama-project-anda.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/dashboard-hemp%40nama-project-anda.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
